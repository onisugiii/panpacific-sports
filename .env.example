# Copy this file to .env for local development (never commit the real .env).
# On Vercel, set these under Project Settings → Environment Variables instead.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string -- used to sign login tokens
JWT_SECRET=change-this-to-something-long-and-random

# Only used for local dev (npm run dev); Vercel ignores this
PORT=3000

# Optional -- only used by `npm run seed` to set the initial coordinator login
SEED_COORDINATOR_EMAIL=coordinator@campus.edu
SEED_COORDINATOR_PASSWORD=coordinator123
